{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Type-checking only: tests are never emitted, so this project opts out of
    // the composite and declaration settings the build project needs.
    // `pnpm typecheck` runs it after the build project, which is what makes a
    // broken test file a failing gate rather than a red run.
    "composite": false,
    "incremental": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"],
  "exclude": []
}
