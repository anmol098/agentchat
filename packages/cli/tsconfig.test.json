{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Type-checking only: tests are never emitted, so this project opts out of
    // the composite and declaration settings the build project needs.
    // `pnpm typecheck` runs it after the build project, which is what makes a
    // broken test file a failing gate rather than a red run.
    "composite": false,
    "incremental": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,

    // The build project roots at `src` because that is what `dist` mirrors.
    // This project also has to reach `tests/`, which sits beside it, and since
    // nothing here is emitted there is no output layout for a wider root to
    // disturb.
    "rootDir": "."
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"],
  "exclude": []
}
