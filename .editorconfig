# Editor defaults for AgentChat.
#
# These values are deliberately identical to the `formatter` block in
# biome.json, and Biome reads this file (formatter.useEditorconfig = true), so
# an editor that honours EditorConfig and a `pnpm format` run agree byte for
# byte. Change one and you must change the other, or the pull-request gate will
# start rewriting whatever your editor just saved.

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
max_line_length = 100
insert_final_newline = true
trim_trailing_whitespace = true

# Markdown uses two trailing spaces as a hard line break, so trimming them
# silently changes rendered output.
[*.md]
trim_trailing_whitespace = false
max_line_length = off

# Generated by pnpm; nothing here is hand-edited and the file has its own
# formatting conventions.
[pnpm-lock.yaml]
indent_size = 2
max_line_length = off
