# Refuse to install under a Node version the workspace does not support, rather
# than failing later with a confusing runtime error.
engine-strict=true

# Peer dependency problems should be visible at install time, not at runtime.
strict-peer-dependencies=true
auto-install-peers=false
dedupe-peer-dependents=true

# Exact versions everywhere. This repository ships a server other people run and
# a CLI other people install; a floating range that resolves differently on two
# machines is a support burden nobody needs.
save-exact=true
