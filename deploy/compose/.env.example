# SPDX-License-Identifier: AGPL-3.0-or-later
#
# AgentChat reference deployment: environment template.
#
#   cp .env.example .env
#   chmod 600 .env
#   ${EDITOR:-vi} .env
#
# `.env` holds three secrets in plain text and must never be committed. The
# repository's .gitignore excludes it, and so does the .gitignore next to this
# file, so the exclusion travels with the directory when it is copied to a
# server. If you ever paste one of these values into an issue or a chat,
# rotate it.
#
# Every variable this stack reads is listed below. Anything marked REQUIRED has
# no default: Compose refuses to start, naming the variable, rather than
# guessing. Everything else shows its default and can stay commented out.
#
# Which program reads what:
#
#   [server]     the server process only
#   [migrate]    the one-shot migration container only
#   [both]       both of them
#   [proxy]      Caddy
#   [postgres]   the database container
#   [compose]    resolved by Compose itself, before any container starts
#
# The [server]-only credentials are deliberately not given to the migration
# job. Applying a schema change signs no tokens and logs nobody in, so a
# first-time self-hoster can create the database schema before registering a
# GitHub OAuth application.

# ---------------------------------------------------------------------------
# Release  [compose]
# ---------------------------------------------------------------------------

# REQUIRED. The exact release to run. There is no default and `latest` is
# never substituted: `docker compose up` must never perform an unplanned
# upgrade, because an upgrade runs migrations against your data. Set it to a
# version whose release notes you have read, and change it when you mean to
# upgrade.
#
# This file ships with the release it belongs to, and the release pipeline
# refuses to publish a version this line does not name.
AGENTCHAT_VERSION=0.3.0

# The image repository, without a tag. Change it only if you publish your own
# build. A fork you host yourself is exactly the case the AGPL exists for.
#AGENTCHAT_IMAGE=ghcr.io/anmol098/agentchat-server

# ---------------------------------------------------------------------------
# TLS and the public name  [proxy]
# ---------------------------------------------------------------------------

# REQUIRED. The hostname this deployment answers on. An A record (and AAAA if
# you have IPv6) for it must already point at this machine, and ports 80 and
# 443 must be reachable from the internet, before the first start: that is how
# the certificate authority proves you control the name. Certificates are then
# obtained and renewed automatically for as long as the stack runs.
#
# Use `localhost` to smoke-test without a domain; Caddy then issues from its
# own internal CA and never contacts a public authority. See README.md.
AGENTCHAT_DOMAIN=chat.example.com

# REQUIRED. Contact address for the ACME account. The certificate authority
# uses it for expiry and policy warnings, which is the mail that arrives when
# renewal has been failing for a week and nobody noticed. Unused when
# AGENTCHAT_DOMAIN=localhost, but still required, so a stack that was tested
# locally cannot be pointed at a real name while missing it.
ACME_EMAIL=admin@example.com

# Host ports the proxy binds. Change them only if something else on the
# machine already owns 80 and 443 and you have a load balancer in front. The
# ACME challenge still needs port 80 reachable from the internet, whatever it
# is mapped to here.
#HTTP_PORT=80
#HTTPS_PORT=443

# ---------------------------------------------------------------------------
# Server credentials  [server]
# ---------------------------------------------------------------------------
# None of these are read by the migration job.

# REQUIRED. HS256 signing key for access tokens. At least 32 characters of
# unguessable text:
#
#   openssl rand -hex 32
#
# Changing it invalidates every outstanding access token. Users are not
# signed out: the CLI redeems its refresh token on the next request and
# carries on. See docs/self-hosting.md, "Rotating the signing secret".
JWT_SECRET=

# REQUIRED. A GitHub OAuth application with device flow enabled, which is the
# flow the CLI uses to log in. Create one at
# https://github.com/settings/developers; docs/self-hosting.md walks through
# the form. Neither value is needed to create the database schema, so you can
# bring the stack up, apply migrations, and come back to this before anyone
# logs in.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Database  [postgres] [both]
# ---------------------------------------------------------------------------

# REQUIRED. The password PostgreSQL is initialised with and both containers
# connect with. Generate it with `openssl rand -hex 32`: it is interpolated
# into a connection URL, so hex avoids any question of percent-encoding.
#
# It is baked into the data directory on first start. Changing this line later
# changes only what the clients send, and they will be refused. To rotate it,
# run `ALTER USER` inside the database and update this line in the same
# maintenance window.
POSTGRES_PASSWORD=

# The role and database created on first start. Both are baked into the volume
# at initialisation; changing them afterwards points the stack at a database
# that does not exist.
#POSTGRES_USER=agentchat
#POSTGRES_DB=agentchat

# Connection pool, sized for one server and one database on one machine.
#DATABASE_POOL_MAX=10
#DATABASE_CONNECTION_TIMEOUT_MS=5000
#DATABASE_IDLE_TIMEOUT_MS=30000

# ---------------------------------------------------------------------------
# Migrations  [migrate]
# ---------------------------------------------------------------------------

# How long the migration job waits for the PostgreSQL advisory lock before
# giving up with exit 69, which means "try again". Raise it if you have a long
# migration and a supervisor that might start two containers at once.
#MIGRATION_LOCK_TIMEOUT_MS=60000

# ---------------------------------------------------------------------------
# Rollback  [both]
# ---------------------------------------------------------------------------

# Leave this false. Both the migration job and the server refuse, with exit
# 65, to run against a database whose schema is newer than the image knows.
# That is exactly what a rollback looks like, because nothing records which
# release a migration came from.
#
# Set it to true only while deliberately running an older AGENTCHAT_VERSION
# against a newer schema, and set it back the moment you roll forward. One
# minor version of backward compatibility is guaranteed; further back than
# that is a restore from backup, not a rollback. See docs/upgrading.md.
#AGENTCHAT_ALLOW_SCHEMA_AHEAD=false

# ---------------------------------------------------------------------------
# Operational  [server] [migrate]
# ---------------------------------------------------------------------------

# trace | debug | info | warn | error | fatal | silent. Structured JSON on
# stdout, collected by Docker.
#LOG_LEVEL=info

# How long the server may spend closing sockets and draining the pool after
# SIGTERM before it gives up and exits non-zero.
#
# It must stay comfortably below AGENTCHAT_STOP_GRACE_PERIOD. The server uses
# this budget to shut down and then log why it stopped; if the orchestrator's
# SIGKILL lands first, every stop looks like a crash and the explanation is
# lost. Raise the two together, and TimeoutStopSec in agentchat.service with
# them.
#SHUTDOWN_TIMEOUT_MS=10000

# How long Docker waits after SIGTERM before SIGKILL. Compose's own default is
# 10s, the same as SHUTDOWN_TIMEOUT_MS, which is too tight for the reason
# above, so this stack sets 30s instead.
#AGENTCHAT_STOP_GRACE_PERIOD=30s
