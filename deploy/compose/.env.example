# SPDX-License-Identifier: AGPL-3.0-or-later
#
# AgentChat reference deployment — environment template.
#
#   cp .env.example .env
#   chmod 600 .env
#   ${EDITOR:-vi} .env
#
# `.env` holds three secrets in plain text and must never be committed: the
# repository's .gitignore excludes it, and so does the .gitignore next to this
# file, so that the exclusion travels with the directory when it is copied to a
# server. If you ever paste one of these values into an issue or a chat, rotate
# it rather than hoping.
#
# Every variable this stack reads is listed below. Anything marked REQUIRED has
# no default: Compose refuses to start — with a message naming the variable —
# rather than guessing. Everything else shows its default and can stay
# commented out.
#
# Which program reads what:
#
#   [server]     the server process only
#   [migrate]    the one-shot migration container only
#   [both]       both of them
#   [proxy]      Caddy
#   [postgres]   the database container
#   [compose]    resolved by Compose itself, before any container starts
#
# The [server]-only credentials are the point of the split. Applying a schema
# change signs no tokens and logs nobody in, so the migration job is not given
# JWT_SECRET or the OAuth credentials and does not ask for them (T-022). A
# first-time self-hoster can therefore create their database schema before they
# have registered a GitHub OAuth application.

# ---------------------------------------------------------------------------
# Release  [compose]
# ---------------------------------------------------------------------------

# REQUIRED. The exact release to run. There is deliberately no default and
# `latest` is never substituted: `docker compose up` must never be able to
# perform an unplanned upgrade, because an upgrade runs migrations against
# production data (Plan section 12.1, section 12.5). Set it to a version you have read the
# release notes for, and change it when you mean to upgrade.
AGENTCHAT_VERSION=0.1.0

# The image repository, without a tag. Change it only if you publish your own
# build — a fork you host yourself is exactly the case the AGPL exists for.
#AGENTCHAT_IMAGE=ghcr.io/anmol098/agentchat-server

# ---------------------------------------------------------------------------
# TLS and the public name  [proxy]
# ---------------------------------------------------------------------------

# REQUIRED. The hostname this deployment answers on. An A record (and AAAA if
# you have IPv6) for it must already point at this machine, and ports 80 and
# 443 must be reachable from the internet, before the first start: that is how
# the certificate authority proves you control the name. Certificates are then
# obtained and renewed automatically for as long as the stack runs.
#
# Use `localhost` to smoke-test without a domain; Caddy then issues from its
# own internal CA and never contacts an authority. See README.md.
AGENTCHAT_DOMAIN=chat.example.com

# REQUIRED. Contact address for the ACME account. The certificate authority
# uses it for expiry and policy warnings — the mail that arrives when renewal
# has been failing for a week and nobody noticed. Unused when
# AGENTCHAT_DOMAIN=localhost, but still required, so a stack that was tested
# locally cannot be pointed at a real name while missing it.
ACME_EMAIL=admin@example.com

# Host ports the proxy binds. Change them only if something else on the machine
# already owns 80/443 and you have a load balancer in front. ACME's HTTP-01
# challenge needs port 80 to be reachable *from the internet* on 80, whatever
# it is mapped to here.
#HTTP_PORT=80
#HTTPS_PORT=443

# ---------------------------------------------------------------------------
# Server credentials  [server]
# ---------------------------------------------------------------------------
# None of these are read by the migration job.

# REQUIRED. HS256 signing key for access tokens. At least 32 characters of
# unguessable text:
#
#   openssl rand -hex 32
#
# Changing it invalidates every outstanding access token, which is the
# emergency lever if one is believed stolen. It is not a rotation mechanism:
# every logged-in user has to log in again.
JWT_SECRET=

# REQUIRED. A GitHub OAuth application, with **device flow enabled** — that is
# the flow the CLI uses to log in (Plan section 7). Create one at
# https://github.com/settings/developers. Nothing about it is needed to create
# the database schema, so you can bring the stack up, apply migrations and come
# back to this before anyone logs in.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Database  [postgres] [both]
# ---------------------------------------------------------------------------

# REQUIRED. The password Postgres is initialised with and both containers
# connect with. Generate it with `openssl rand -hex 32`: it is interpolated
# into a connection URL, so hex avoids any question of percent-encoding.
#
# It is baked into the data directory on first start. Changing this line later
# changes only what the clients send, and they will be refused; to rotate it,
# `ALTER USER` inside the database and update this in the same maintenance
# window.
POSTGRES_PASSWORD=

# The role and database created on first start. Both are baked into the volume
# at initialisation; changing them afterwards points the stack at a database
# that does not exist.
#POSTGRES_USER=agentchat
#POSTGRES_DB=agentchat

# Connection pool, sized for one server and one database on one VM.
#DATABASE_POOL_MAX=10
#DATABASE_CONNECTION_TIMEOUT_MS=5000
#DATABASE_IDLE_TIMEOUT_MS=30000

# ---------------------------------------------------------------------------
# Migrations  [migrate]
# ---------------------------------------------------------------------------

# How long the migration job waits for the Postgres advisory lock before
# giving up with exit 69 ("try again"). Raise it if you have a long migration
# and a supervisor that starts two containers at once.
#MIGRATION_LOCK_TIMEOUT_MS=60000

# ---------------------------------------------------------------------------
# Rollback  [both]
# ---------------------------------------------------------------------------

# Leave this false. Both the migration job and the server refuse, with exit 65,
# to run against a database whose schema is newer than the image knows — which
# is precisely what a rollback looks like, because nothing records which
# release a migration came from (Plan section 12.2).
#
# Set it to true *only* while deliberately running an older AGENTCHAT_VERSION
# against a newer schema, and set it back the moment you roll forward. section 12.3
# guarantees one minor version of backward compatibility; further back than
# that is a restore from backup, not a rollback.
#AGENTCHAT_ALLOW_SCHEMA_AHEAD=false

# ---------------------------------------------------------------------------
# Operational  [server] [migrate]
# ---------------------------------------------------------------------------

# trace | debug | info | warn | error | fatal | silent. Structured JSON on
# stdout, collected by Docker.
#LOG_LEVEL=info

# How long the server may spend closing sockets and draining the pool after
# SIGTERM before it gives up and exits non-zero.
#
# It must stay comfortably below AGENTCHAT_STOP_GRACE_PERIOD. The server uses
# this budget to shut down *and then log why it stopped*; if the orchestrator's
# SIGKILL lands first, every stop looks like a crash and the explanation is
# lost. Raise the two together, and TimeoutStopSec in agentchat.service with
# them.
#SHUTDOWN_TIMEOUT_MS=10000

# How long Docker waits after SIGTERM before SIGKILL. Compose's own default is
# 10s — the same as SHUTDOWN_TIMEOUT_MS, which is too tight for the reason
# above — so this stack sets 30s instead.
#AGENTCHAT_STOP_GRACE_PERIOD=30s
