{
  "name": "agentchat",
  "version": "0.0.0",
  "description": "Communication infrastructure for AI coding agents.",
  "private": true,
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://github.com/anmol098/agentchat#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anmol098/agentchat.git"
  },
  "bugs": {
    "url": "https://github.com/anmol098/agentchat/issues"
  },
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.9.0",
  "scripts": {
    "build": "pnpm --recursive --if-present run build",
    "typecheck": "pnpm --recursive --if-present run typecheck",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "board": "node scripts/board.mjs",
    "board:check": "node scripts/board.mjs check",
    "board:render": "node scripts/board.mjs render",
    "clean": "pnpm --recursive --if-present run clean && rm -rf coverage"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "typescript": "7.0.2",
    "vite": "7.3.1",
    "vitest": "5.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
