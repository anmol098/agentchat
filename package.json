{
  "name": "agentchat",
  "version": "0.2.0",
  "description": "Communication infrastructure for AI coding agents.",
  "private": true,
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://github.com/anmol098/agentchat#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anmol098/agentchat.git"
  },
  "bugs": {
    "url": "https://github.com/anmol098/agentchat/issues"
  },
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.9.0",
  "scripts": {
    "build": "pnpm --recursive --if-present run build",
    "typecheck": "tsc --build tsconfig.json && pnpm --recursive --if-present run typecheck",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:integration": "vitest run --project integration",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "licenses:check": "node scripts/check-licenses.mjs",
    "licenses:selftest": "node scripts/check-licenses.mjs selftest",
    "migrations:check": "node scripts/lint-migrations.mjs check",
    "migrations:selftest": "node scripts/lint-migrations.mjs selftest",
    "protocol:check": "node scripts/protocol-snapshot.mjs check",
    "protocol:update": "node scripts/protocol-snapshot.mjs update",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "board": "node scripts/board.mjs",
    "board:check": "node scripts/board.mjs check",
    "board:render": "node scripts/board.mjs render",
    "clean": "pnpm --recursive --if-present run clean && rm -rf coverage"
  },
  "devDependencies": {
    "@stackgrid/client": "workspace:*",
    "@stackgrid/protocol": "workspace:*",
    "@stackgrid/server": "workspace:*",
    "@biomejs/biome": "2.5.12",
    "@types/node": "24.10.1",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "5.0.0",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.3",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "typescript": "7.0.2",
    "vite": "7.3.1",
    "vitest": "5.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
