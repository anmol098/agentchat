{
  "name": "@stackgrid/server",
  "version": "0.3.0",
  "description": "AgentChat server: HTTP API, WebSocket routing, and persistence.",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "homepage": "https://github.com/anmol098/agentchat#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anmol098/agentchat.git",
    "directory": "server"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc --build",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/src/index.js",
    "typecheck": "tsc --build && tsc --project tests/tsconfig.json",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@stackgrid/protocol": "workspace:*",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.3",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "ws": "8.21.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/pg": "8.23.1",
    "@types/ws": "8.18.1",
    "drizzle-kit": "0.31.10",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
